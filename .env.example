# --- Path 1 (default) -------------------------------------------------
# Leave the two REDDIT_ vars unset and Shikaar uses Reddit's public JSON
# endpoints. Fine for validating the product. Expect intermittent 403s
# from datacenter IPs (PRD §8).

# Always set this. Reddit blocks generic user agents.
SHIKAAR_USER_AGENT="web:shikaar:1.0.0 (by /u/YOUR_REDDIT_USERNAME)"

# --- Path 2 (recommended for production, PRD §6.3) --------------------
# https://www.reddit.com/prefs/apps → "create app" → type: web app
# Set both and the adapter upgrades to OAuth automatically. No code change.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Tuning -----------------------------------------------------------
# SHIKAAR_CACHE_TTL_MS=120000
# SHIKAAR_TIMEOUT_MS=9000
# PORT=3000
